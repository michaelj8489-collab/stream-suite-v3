{
  "name": "stream-suite-v3",
  "version": "1.0.0",
  "description": "",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:visualizer": "node build-visualizer.js",
    "watch:visualizer": "node build-visualizer.js --watch",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.streamsuite.app",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "icon": "stream-suite-logo.png"
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.video"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "electron": "^42.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0"
  },
  "dependencies": {
    "@react-three/postprocessing": "^3.0.4",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  }
}
